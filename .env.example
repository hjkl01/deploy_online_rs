# 复制为 .env 后修改（优先读取 $DEPLOY_ONLINE_DATA/.env，其次当前目录 .env）
# cp .env.example .env && chmod 600 .env

# 必填：会话签名 + Project Secrets 加密密钥，至少 16 字符
# 生成：openssl rand -hex 32
# 注意：更换后已存 secret 无法解密、所有会话失效
SECRET_KEY=

# 必填：管理员密码，首次启动写入数据库（不能是默认值 admin）
ADMIN_PASSWORD=

# 管理员用户名
ADMIN_USERNAME=admin

# 同时执行的部署数
WORKER_CONCURRENCY=4

# 启动时清理超过 N 天的日志
LOG_RETENTION_DAYS=30

# 监听地址（公网请配合反向代理 + HTTPS）
DEPLOY_ONLINE_BIND=127.0.0.1:8000

# 数据目录（SQLite、密钥、projects/），默认 XDG data 下的 deploy_online
# DEPLOY_ONLINE_DATA=/var/lib/deploy_online

# 日志级别：error / warn / info / debug / trace，可细化到模块
RUST_LOG=info